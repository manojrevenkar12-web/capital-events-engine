{
  "name": "@cee/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capital events API: NestJS 12 on Fastify, MySQL 8 via Kysely",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --copy-files && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "swc src -d dist --strip-leading-paths -w & node --watch dist/main.js",
    "migrate": "node dist/db/migrate-cli.js",
    "seed": "node dist/seed/seed-cli.js",
    "openapi": "node dist/openapi-cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@cee/engine": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "kysely": "0.29.7",
    "mysql2": "3.24.6",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
